# Required in production: the one secret that unlocks your brain (web app, extension, MCP).
# Generate: node -e "console.log('brn_' + require('crypto').randomBytes(24).toString('base64url'))"
BRAIN_TOKEN=

# Postgres connection string (Neon, Supabase, Railway, Render…). Omit locally to use embedded PGlite in ./data.
DATABASE_URL=

# Your timezone, so "today" and daily digests line up with your day.
BRAIN_TZ=Asia/Kolkata

# Name shown in the greeting (optional).
BRAIN_OWNER=

# Optional server-side AI ("cortex"): page/session summaries, nightly digests, written answers in Ask.
# Without it, summaries are extractive and Claude Code runs the nightly dream via MCP (/mcp__brain__dream).
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5

# Optional: expose /connector/<token>/mcp for MCP clients that can't send headers.
BRAIN_CONNECTOR_URL=0

# Keep full page text after nightly compaction (default: trimmed to 600 chars once digested).
BRAIN_KEEP_RAW=0

PORT=4321
