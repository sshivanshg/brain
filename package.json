{
  "name": "brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal second brain: one memory for every agent, browser and device.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "import": "node scripts/import.mjs",
    "connect": "node scripts/connect.mjs",
    "icons": "python3 scripts/icons.py",
    "service": "node scripts/service.mjs",
    "setup": "npm ci --no-audit --no-fund && npm run hooks",
    "hooks": "git config core.hooksPath .githooks",
    "check": "node scripts/quality.mjs check",
    "check:design": "node scripts/quality.mjs design"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "bin": {
    "brain": "bin/brain.mjs"
  }
}
