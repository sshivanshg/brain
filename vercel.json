{
  "buildCommand": "",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/share",
      "destination": "/api"
    },
    {
      "source": "/connector/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "30 2 * * *"
    }
  ]
}
